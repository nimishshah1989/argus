{
  "name": "uptimo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && pnpm build:server && pnpm build:web",
    "parity": "tsx tools/check-parity.ts",
    "parity:update": "tsx tools/check-parity-update.ts",
    "size": "tsx tools/check-size.ts",
    "deps": "tsx tools/check-deps.ts",
    "shortcuts": "tsx tools/check-shortcuts.ts",
    "pr:size": "tsx tools/check-pr-size.ts",
    "migrations:check": "tsx tools/check-migrations.ts",
    "migrations:immutable": "tsx tools/check-migration-immutability.ts",
    "docs:check": "tsx tools/check-docs.ts",
    "pii:scan": "tsx tools/check-pii.ts",
    "changelog:check": "tsx tools/check-changelog.ts",
    "licences": "tsx tools/check-licences.ts",
    "boundaries": "tsx tools/check-boundaries.ts",
    "audit:lean": "pnpm size && pnpm deps && pnpm shortcuts && pnpm boundaries",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm parity && pnpm licences && pnpm migrations:check && pnpm ui:check && pnpm docs:check && pnpm pii:scan && pnpm audit:lean",
    "test:e2e": "playwright test",
    "ui:check": "tsx tools/check-ui.ts",
    "gallery:test": "playwright test -c playwright.gallery.config.ts",
    "gallery:update": "playwright test -c playwright.gallery.config.ts --update-snapshots=all --grep-invert @planted",
    "gallery:update:docker": "docker run --rm --ipc=host -v \"$PWD\":/src:ro -v \"$PWD/apps/web/e2e/gallery/__screenshots__\":/out mcr.microsoft.com/playwright:v1.65.0-noble bash /src/tools/gallery-baselines.sh",
    "seed:cosmos": "tsx scripts/seed-cosmos.ts",
    "migrate": "tsx scripts/migrate.ts",
    "import:bhavin": "tsx tools/import-bhavin.ts",
    "import:undo": "tsx tools/import-bhavin.ts undo",
    "build:server": "tsx scripts/build-server.ts",
    "build:web": "pnpm --filter @uptimo/web build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
