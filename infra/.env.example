# Copy to .env.local for development. Never commit a real value.
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgres://argus:argus@localhost:5432/argus
SESSION_SECRET=change-me-in-local-only
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=argus-local
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_REGION=ap-south-1
# Meta WhatsApp (M3)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Sarvam (M3)
SARVAM_API_KEY=
# Web push (M1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Caps (settings seed)
MAX_WHATSAPP_MESSAGES_PER_DAY=500
MAX_ASR_MINUTES_PER_DAY=120
MAX_EMAILS_PER_DAY=1000
