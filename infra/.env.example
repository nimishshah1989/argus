# Copy to .env.local for development. Never commit a real value.
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# The domain the plants' addresses sit under (a plant is <slug>.<this>): a bare host name, no scheme, path or port.
# The sign-off QR code is built from it. Unset, that QR answers 503; a malformed value stops the server starting.
# Staging: 3-108-95-203.sslip.io
PUBLIC_BASE_DOMAIN=
DATABASE_URL=postgres://uptimo:uptimo@localhost:5432/uptimo
SESSION_SECRET=change-me-in-local-only
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=uptimo-local
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_REGION=ap-south-1
# Meta WhatsApp (M3)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Sarvam (M3)
SARVAM_API_KEY=
# Web push (M1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Erased stays erased (set in AWS Secrets Manager, D19): the key of the hash that stops an erased person being created
# or imported again. At least 32 random characters. Without it nobody can be erased, and a plant that has erased people
# refuses to create people. NEVER change or lose it: a new key silently re-opens every erased person.
ERASURE_HASH_KEY=
# Caps (settings seed)
MAX_WHATSAPP_MESSAGES_PER_DAY=500
MAX_ASR_MINUTES_PER_DAY=120
MAX_EMAILS_PER_DAY=1000
# AI (M6): the key alone is enough; the model defaults to claude-sonnet-5-5 and listed models price themselves
ANTHROPIC_API_KEY=
AI_MODEL=
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=
AI_MAX_OUTPUT_TOKENS=1024
AI_DEFAULT_MONTHLY_CAP_USD=50
# Support access (D29): who may ask for access to a customer's data. `name:sha256hex,...` (only the hash of each key, never the key).
SUPPORT_KEYS=
# The public domain the sign-off QR links use, with no scheme: https://<plant slug>.<this>/floor/signoff/<id>. Staging: the sslip.io host.
PUBLIC_BASE_DOMAIN=
# AI residency: the operator's written record that the provider may be called from where it is (an attestation, a name only).
AI_RESIDENCY_RECORD=
