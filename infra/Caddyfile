# SITE_ADDRESS (a host name for automatic HTTPS, or :80 for plain HTTP) and ACME_EMAIL
# come from Terraform through /opt/uptimo/.env.
{
  email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
  reverse_proxy /api/* server:3001

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
