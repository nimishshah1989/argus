# SITE_ADDRESS (a host name for automatic HTTPS, or :80 for plain HTTP) and ACME_EMAIL
# come from Terraform through /opt/uptimo/.env.
{
  email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
  # Caddy runs `handle` before `reverse_proxy`, so the API needs its own handle block;
  # a bare `reverse_proxy /api/*` is never reached and /api gets the web app's index.html.
  handle /api/* {
    reverse_proxy server:3001
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
