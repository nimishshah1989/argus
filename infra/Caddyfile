# No domain yet: SITE_ADDRESS defaults to :80, so Caddy serves plain HTTP and skips
# Let's Encrypt. Once a domain exists, set SITE_ADDRESS=cosmos.<domain> for automatic HTTPS.
{
  email ops@example.com
}

{$SITE_ADDRESS} {
  reverse_proxy /api/* server:3001

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
